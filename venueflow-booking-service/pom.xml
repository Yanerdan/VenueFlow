<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.yanerdan.venueflow</groupId>
    <artifactId>venueflow-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>venueflow-booking-service</artifactId>
  <packaging>jar</packaging>

  <name>VenueFlow Booking Service</name>
  <description>Infrastructure-independent VenueFlow Booking Service skeleton</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.yanerdan.venueflow</groupId>
        <artifactId>venueflow-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-booking-service-direct-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Booking Service may directly depend only on approved Web, Actuator, and test support.</message>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>*:*</exclude>
                  </excludes>
                  <includes>
                    <include>org.springframework.boot:spring-boot-starter-webmvc</include>
                    <include>org.springframework.boot:spring-boot-starter-actuator</include>
                    <include>org.springframework.boot:spring-boot-starter-test</include>
                    <include>org.springframework.boot:spring-boot-starter-webmvc-test</include>
                    <include>org.springframework.boot:spring-boot-starter-validation</include>
                    <include>com.baomidou:mybatis-plus-spring-boot4-starter</include>
                    <include>org.springframework.boot:spring-boot-starter-flyway</include>
                    <include>org.springframework.boot:spring-boot-starter-amqp</include>
                    <include>org.flywaydb:flyway-mysql</include>
                    <include>com.mysql:mysql-connector-j</include>
                    <include>org.testcontainers:testcontainers-junit-jupiter</include>
                    <include>org.testcontainers:testcontainers-mysql</include>
                    <include>org.testcontainers:testcontainers-rabbitmq</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-booking-service-forbidden-transitives</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Booking Service skeleton must remain free of persistence, security, distributed infrastructure, and business-service clients.</message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.yanerdan.venueflow:venueflow-resource-service</exclude>
                    <exclude>com.yanerdan.venueflow:venueflow-user-service</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-data-*</exclude>
                    <exclude>org.springframework.data:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.liquibase:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>org.mariadb.jdbc:*</exclude>
                    <exclude>com.h2database:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-security</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-oauth2-*</exclude>
                    <exclude>org.springframework.security:*</exclude>
                    <exclude>io.jsonwebtoken:*</exclude>
                    <exclude>com.auth0:java-jwt</exclude>
                    <exclude>org.springframework.cloud:*</exclude>
                    <exclude>com.alibaba.cloud:*</exclude>
                    <exclude>com.alibaba.nacos:*</exclude>
                    <exclude>com.alibaba.csp:*</exclude>
                    <exclude>io.github.openfeign:*</exclude>
                    <exclude>redis.clients:*</exclude>
                    <exclude>io.lettuce:*</exclude>
                    <exclude>org.redisson:*</exclude>
                    <exclude>org.springframework.kafka:*</exclude>
                    <exclude>org.apache.kafka:*</exclude>
                    <exclude>io.micrometer:micrometer-tracing*</exclude>
                    <exclude>io.micrometer:micrometer-registry-prometheus*</exclude>
                    <exclude>io.opentelemetry:*</exclude>
                    <exclude>io.zipkin.brave:*</exclude>
                    <exclude>io.prometheus:*</exclude>
                    <exclude>org.elasticsearch:*</exclude>
                    <exclude>co.elastic.clients:*</exclude>
                    <exclude>org.opensearch.client:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.yanerdan.venueflow.booking.BookingServiceApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mysql-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.6</version>
            <executions>
              <execution>
                <id>run-booking-mysql-integration-tests</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/*MysqlSuite.java</include>
                  </includes>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>outbox-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.6</version>
            <executions>
              <execution>
                <id>run-booking-outbox-integration-tests</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/*OutboxSuite.java</include>
                  </includes>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>reconciliation-it</id>

      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.6</version>

            <executions>
              <execution>
                <id>reconciliation-integration-tests</id>

                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>

                <configuration>
                  <includes>
                    <include>**/*ReconciliationSuite.java</include>
                  </includes>

                  <failIfNoTests>true</failIfNoTests>

                  <systemPropertyVariables>
                    <venueflow.reconciliation.it>true</venueflow.reconciliation.it>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
