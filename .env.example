# Copy this file to .env and replace placeholders locally. Never commit .env.
VENUEFLOW_ENV=dev
INFRA_BIND_ADDRESS=127.0.0.1

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-namespace-id
NACOS_AUTH_ENABLE=true
NACOS_AUTH_TOKEN=replace-with-base64-token-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-identity-value
NACOS_USERNAME=replace-with-nacos-client-user
NACOS_PASSWORD=replace-with-local-nacos-client-password
VENUEFLOW_NACOS_GROUP=VENUEFLOW_GROUP
VENUEFLOW_INSTANCE_ID=replace-with-unique-instance-id

VMWARE_HOST_ONLY_CIDR=192.168.72.0/24
VMWARE_HOST_IP=192.168.72.1
INFRA_NODE_IP=192.168.72.11
APP_NODE_IP=192.168.72.12

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=replace-with-database
MYSQL_USERNAME=replace-with-username
MYSQL_PASSWORD=replace-with-local-secret
MYSQL_ROOT_PASSWORD=replace-with-local-root-secret

# Resource Service persistence profile. Required only when SPRING_PROFILES_ACTIVE=persistence.
# The venueflow_resource schema and its least-privilege user are created in C04 task group 2.
VENUEFLOW_RESOURCE_DB_URL=jdbc:mysql://127.0.0.1:3306/venueflow_resource
VENUEFLOW_RESOURCE_DB_USERNAME=replace-with-resource-service-db-user
VENUEFLOW_RESOURCE_DB_PASSWORD=replace-with-local-resource-service-db-password

# User Service persistence profile. Required only when SPRING_PROFILES_ACTIVE includes persistence.
# Create the schema and least-privilege database account locally; Flyway V001 creates the User Service tables.
VENUEFLOW_USER_DB_URL=jdbc:mysql://127.0.0.1:3306/venueflow_user
VENUEFLOW_USER_DB_USERNAME=replace-with-local-user-service-db-user
VENUEFLOW_USER_DB_PASSWORD=replace-with-local-user-service-db-password

# Auth credential/token lifecycle; required only with SPRING_PROFILES_ACTIVE=persistence.
VENUEFLOW_AUTH_DB_URL=jdbc:mysql://127.0.0.1:3306/venueflow_auth
VENUEFLOW_AUTH_DB_USERNAME=replace-with-local-auth-service-db-user
VENUEFLOW_AUTH_DB_PASSWORD=replace-with-local-auth-service-db-password
VENUEFLOW_AUTH_ISSUER=venueflow-auth-service
VENUEFLOW_AUTH_ACCESS_TOKEN_TTL=PT15M
VENUEFLOW_AUTH_REFRESH_TOKEN_TTL=P7D
VENUEFLOW_AUTH_MAX_LOGIN_ATTEMPTS=5
VENUEFLOW_AUTH_LOCKOUT_DURATION=PT15M

# Reactive Gateway profile. JWT_PUBLIC_KEY must match Auth's JWT_PRIVATE_KEY.
VENUEFLOW_GATEWAY_AUTH_URI=http://127.0.0.1:8081
VENUEFLOW_GATEWAY_USER_URI=http://127.0.0.1:8082
VENUEFLOW_GATEWAY_RESOURCE_URI=http://127.0.0.1:8083
VENUEFLOW_GATEWAY_BOOKING_URI=http://127.0.0.1:8084
VENUEFLOW_GATEWAY_SEARCH_URI=http://127.0.0.1:8086
VENUEFLOW_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:3000
VENUEFLOW_GATEWAY_MAX_REQUEST_BYTES=1048576

# Booking Service persistence profile. Required only when explicitly selected.
VENUEFLOW_BOOKING_DB_URL=jdbc:mysql://127.0.0.1:3306/venueflow_booking
VENUEFLOW_BOOKING_DB_USERNAME=replace-with-local-booking-service-db-user
VENUEFLOW_BOOKING_DB_PASSWORD=replace-with-local-booking-service-db-password
VENUEFLOW_USER_SERVICE_BASE_URL=http://127.0.0.1:8082
VENUEFLOW_RESOURCE_SERVICE_BASE_URL=http://127.0.0.1:8083
VENUEFLOW_COLLABORATOR_CONNECT_TIMEOUT_MS=1000
VENUEFLOW_COLLABORATOR_REQUEST_TIMEOUT_MS=2000
VENUEFLOW_RESOURCE_LOOKUP_ATTEMPTS=2

# Booking reconciliation; requires SPRING_PROFILES_ACTIVE=persistence,reconciliation.
VENUEFLOW_RECONCILIATION_ENABLED=false
VENUEFLOW_RECONCILIATION_BATCH_SIZE=20
VENUEFLOW_RECONCILIATION_LEASE_DURATION=PT30S
VENUEFLOW_RECONCILIATION_SCAN_DELAY=PT10S
VENUEFLOW_RECONCILIATION_MAX_ATTEMPTS=8
VENUEFLOW_RECONCILIATION_INITIAL_BACKOFF=PT5S
VENUEFLOW_RECONCILIATION_MAX_BACKOFF=PT15M
VENUEFLOW_RECONCILIATION_LOOKUP_TIMEOUT=PT3S
VENUEFLOW_RECONCILIATION_CONNECT_TIMEOUT=PT2S
VENUEFLOW_RECONCILIATION_REQUEST_TIMEOUT=PT5S

# Booking confirmation deadline and timeout expiration; requires
# SPRING_PROFILES_ACTIVE=persistence,expiration.
VENUEFLOW_CONFIRMATION_WINDOW=PT15M
VENUEFLOW_CHECK_IN_EARLY_WINDOW=PT30M
VENUEFLOW_CHECK_IN_LATE_WINDOW=PT30M
VENUEFLOW_EXPIRATION_ENABLED=false
VENUEFLOW_EXPIRATION_BATCH_SIZE=20
VENUEFLOW_EXPIRATION_LEASE_DURATION=PT30S
VENUEFLOW_EXPIRATION_SCAN_DELAY=PT10S
VENUEFLOW_EXPIRATION_MAX_ATTEMPTS=8
VENUEFLOW_EXPIRATION_INITIAL_BACKOFF=PT5S
VENUEFLOW_EXPIRATION_MAX_BACKOFF=PT15M
VENUEFLOW_EXPIRATION_LOOKUP_TIMEOUT=PT3S
VENUEFLOW_EXPIRATION_CONNECT_TIMEOUT=PT2S
VENUEFLOW_EXPIRATION_REQUEST_TIMEOUT=PT5S

# RabbitMQ credentials used by explicitly enabled Booking publication or Notification consumption.
VENUEFLOW_RABBITMQ_HOST=127.0.0.1
VENUEFLOW_RABBITMQ_PORT=5672
VENUEFLOW_RABBITMQ_USERNAME=replace-with-booking-publisher-user
VENUEFLOW_RABBITMQ_PASSWORD=replace-with-local-booking-publisher-password
VENUEFLOW_RABBITMQ_VHOST=/
VENUEFLOW_OUTBOX_EXCHANGE=venueflow.events.v1
VENUEFLOW_OUTBOX_BATCH_SIZE=20
VENUEFLOW_OUTBOX_SCAN_DELAY_MS=1000
VENUEFLOW_OUTBOX_CONFIRM_TIMEOUT_MS=2000
VENUEFLOW_OUTBOX_LEASE_MS=5000
VENUEFLOW_OUTBOX_MAX_ATTEMPTS=5
VENUEFLOW_OUTBOX_INITIAL_BACKOFF_MS=1000
VENUEFLOW_OUTBOX_MAX_BACKOFF_MS=60000
VENUEFLOW_OUTBOX_ENABLED=true

# Notification reliable consumer; required only with SPRING_PROFILES_ACTIVE=persistence,messaging.
VENUEFLOW_NOTIFICATION_DB_URL=jdbc:mysql://127.0.0.1:3306/venueflow_notification
VENUEFLOW_NOTIFICATION_DB_USERNAME=replace-with-local-notification-service-db-user
VENUEFLOW_NOTIFICATION_DB_PASSWORD=replace-with-local-notification-service-db-password
VENUEFLOW_NOTIFICATION_PREFETCH=10
VENUEFLOW_NOTIFICATION_CONCURRENCY=1
VENUEFLOW_NOTIFICATION_RETRY_DELAY_MS=1000
VENUEFLOW_NOTIFICATION_MAX_ATTEMPTS=3

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-secret

# Resource cache and Search are opt-in. Redis/ES never own resource facts.
VENUEFLOW_ENV=dev
ELASTICSEARCH_URI=http://127.0.0.1:9200
ELASTICSEARCH_PORT=9200
RESOURCE_SERVICE_BASE_URI=http://127.0.0.1:8083

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=replace-with-username
RABBITMQ_PASSWORD=replace-with-local-secret

NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_TLS_PORT=9849

# PKCS#8 private key and X.509 public key PEM values. Never commit real key material.
JWT_PUBLIC_KEY=replace-with-untracked-x509-public-key-pem
JWT_PRIVATE_KEY=replace-with-untracked-pkcs8-private-key-pem
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.72.11:4318

# Opt-in stability and observability profiles. Rules remain disabled until measured.
SENTINEL_DASHBOARD=
VENUEFLOW_GATEWAY_CONNECT_TIMEOUT_MS=1000
VENUEFLOW_GATEWAY_RESPONSE_TIMEOUT=5s
VENUEFLOW_GATEWAY_RESPONSE_TIMEOUT_MS=5000
VENUEFLOW_BOOKING_REQUEST_TIMEOUT_MS=4000
VENUEFLOW_TRACE_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
