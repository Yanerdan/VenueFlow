<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yanerdan.venueflow.resource.slot.allocation.persistence.mapper.ResourceSlotAllocationMapper">

  <resultMap id="AllocationResultMap" type="com.yanerdan.venueflow.resource.slot.allocation.persistence.entity.ResourceSlotAllocationEntity">
    <id column="id" property="id"/>
    <result column="slot_id" property="slotId"/>
    <result column="operation_id" property="operationId"/>
    <result column="operation_type" property="operationType"/>
    <result column="quantity" property="quantity"/>
    <result column="request_fingerprint" property="requestFingerprint"/>
    <result column="occupied_quantity_after" property="occupiedQuantityAfter"/>
    <result column="created_at" property="createdAt"/>
    <result column="updated_at" property="updatedAt"/>
  </resultMap>

  <sql id="AllocationColumns">
    id, slot_id, operation_id, operation_type, quantity, request_fingerprint,
    occupied_quantity_after, created_at, updated_at
  </sql>

  <select id="countBySlotId" resultType="long">
    SELECT COUNT(*) FROM resource_slot_allocation WHERE slot_id = #{slotId}
  </select>

  <select id="selectPageBySlotId" resultMap="AllocationResultMap">
    SELECT <include refid="AllocationColumns"/>
    FROM resource_slot_allocation
    WHERE slot_id = #{slotId}
    ORDER BY created_at ASC, id ASC
    LIMIT #{limit} OFFSET #{offset}
  </select>

  <select id="selectByOperationId" resultMap="AllocationResultMap">
    SELECT <include refid="AllocationColumns"/>
    FROM resource_slot_allocation
    WHERE operation_id = #{operationId}
  </select>
</mapper>
