# Runtime image facts validated against official release registries on 2026-07-27.
# Sources: library/mysql, library/redis, library/rabbitmq, nacos/nacos-server,
# docker.elastic.co/elasticsearch/elasticsearch, Prometheus, Grafana, OpenTelemetry, Jaeger.
# All selected tags publish Linux amd64 and arm64 manifests.
MYSQL_IMAGE=mysql:8.4.10
REDIS_IMAGE=redis:7.4.9-bookworm
RABBITMQ_IMAGE=rabbitmq:4.1.8-management
NACOS_IMAGE=nacos/nacos-server:v3.1.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.2.8
PROMETHEUS_IMAGE=prom/prometheus:v3.11.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.153.0
JAEGER_IMAGE=jaegertracing/jaeger:2.18.0
